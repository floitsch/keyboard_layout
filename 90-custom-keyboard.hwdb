evdev:input:b0011v0001p0001eAB83*
 KEYBOARD_KEY_01=capslock # Map esc to capslock.
 KEYBOARD_KEY_29=esc # Map tilde/backtick to escape
 KEYBOARD_KEY_0f=leftctrl # Map tab to control
 KEYBOARD_KEY_3a=rightbrace # Map caps to =\+
 KEYBOARD_KEY_e3=grave # Map function key to ~/`
 KEYBOARD_KEY_1d=leftmeta # Map ctrl to windows key
 KEYBOARD_KEY_db=leftalt # Map Windows key to Alt
 KEYBOARD_KEY_38=tab # Map ALT key to tab
 KEYBOARD_KEY_1b=backslash # Map =/+ to \/|

# 2.4G Mouse (USB 1ea7:0066). Restore the back button's standard key code in
# case an older package mapped it to Meta. The gesture proxy handles it now.
evdev:input:b0003v1EA7p0066e*
 KEYBOARD_KEY_90004=btn_side
