# Dvorak shifted layout plus the laptop's physical-key remaps.
# Scan codes are Linux evdev key codes, as exposed by Android's input stack.

type OVERLAY

# Laptop physical-key remaps.  Caps produces the character that Linux gets by
# sending RIGHT_BRACKET through the Dvorak layout: equals/plus.
map key 1 CAPS_LOCK
map key 41 ESCAPE
map key 15 CTRL_LEFT
map key 58 EQUALS
map key 464 GRAVE
map key 29 META_LEFT
map key 125 ALT_LEFT
map key 56 TAB
map key 27 BACKSLASH

# Dvorak key positions.  Scan 27 intentionally remains BACKSLASH because the
# laptop hwdb changes the physical right-bracket key (Dvorak =/+) to backslash.
map key 12 LEFT_BRACKET
map key 13 RIGHT_BRACKET
map key 16 APOSTROPHE
map key 17 COMMA
map key 18 PERIOD
map key 19 P
map key 20 Y
map key 21 F
map key 22 G
map key 23 C
map key 24 R
map key 25 L
map key 26 SLASH
map key 30 A
map key 31 O
map key 32 E
map key 33 U
map key 34 I
map key 35 D
map key 36 H
map key 37 T
map key 38 N
map key 39 S
map key 40 MINUS
map key 44 SEMICOLON
map key 45 Q
map key 46 J
map key 47 K
map key 48 X
map key 49 B
map key 50 M
map key 51 W
map key 52 V
map key 53 Z

key GRAVE {
    label:                              '`'
    base:                               '`'
    shift:                              '~'
}

key 1 {
    label:                              '1'
    base:                               '!'
    shift:                              '1'
}

key 2 {
    label:                              '2'
    base:                               '@'
    shift:                              '2'
}

key 3 {
    label:                              '3'
    base:                               '#'
    shift:                              '3'
}

key 4 {
    label:                              '4'
    base:                               '$'
    shift:                              '4'
}

key 5 {
    label:                              '5'
    base:                               '%'
    shift:                              '5'
}

key 6 {
    label:                              '6'
    base:                               '^'
    shift:                              '6'
}

key 7 {
    label:                              '7'
    base:                               '&'
    shift:                              '7'
}

key 8 {
    label:                              '8'
    base:                               '*'
    shift:                              '8'
}

key 9 {
    label:                              '9'
    base:                               '<'
    shift:                              '9'
}

key 0 {
    label:                              '0'
    base:                               '>'
    shift:                              '0'
}

key LEFT_BRACKET {
    label:                              '['
    base:                               '['
    shift:                              '{'
}

key RIGHT_BRACKET {
    label:                              ']'
    base:                               ']'
    shift:                              '}'
}

key APOSTROPHE {
    label:                              '\''
    base:                               '\''
    shift:                              '"'
}

key COMMA {
    label:                              ','
    base:                               ','
    shift:                              '('
}

key PERIOD {
    label:                              '.'
    base:                               '.'
    shift:                              ')'
}

key SLASH {
    label:                              '/'
    base:                               '/'
    shift:                              '?'
}

key EQUALS {
    label:                              '='
    base:                               '='
    shift:                              '+'
}

key BACKSLASH {
    label:                              '\\'
    base:                               '\\'
    shift:                              '|'
}

key MINUS {
    label:                              '-'
    base:                               '-'
    shift:                              '_'
}

key SEMICOLON {
    label:                              ';'
    base:                               ';'
    shift:                              ':'
}

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    shift+capslock:                     'a'
}

key B {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
    shift+capslock:                     'b'
}

key C {
    label:                              'C'
    base:                               'c'
    shift, capslock:                    'C'
    shift+capslock:                     'c'
}

key D {
    label:                              'D'
    base:                               'd'
    shift, capslock:                    'D'
    shift+capslock:                     'd'
}

key E {
    label:                              'E'
    base:                               'e'
    shift, capslock:                    'E'
    shift+capslock:                     'e'
}

key F {
    label:                              'F'
    base:                               'f'
    shift, capslock:                    'F'
    shift+capslock:                     'f'
}

key G {
    label:                              'G'
    base:                               'g'
    shift, capslock:                    'G'
    shift+capslock:                     'g'
}

key H {
    label:                              'H'
    base:                               'h'
    shift, capslock:                    'H'
    shift+capslock:                     'h'
}

key I {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
    shift+capslock:                     'i'
}

key J {
    label:                              'J'
    base:                               'j'
    shift, capslock:                    'J'
    shift+capslock:                     'j'
}

key K {
    label:                              'K'
    base:                               'k'
    shift, capslock:                    'K'
    shift+capslock:                     'k'
}

key L {
    label:                              'L'
    base:                               'l'
    shift, capslock:                    'L'
    shift+capslock:                     'l'
}

key M {
    label:                              'M'
    base:                               'm'
    shift, capslock:                    'M'
    shift+capslock:                     'm'
}

key N {
    label:                              'N'
    base:                               'n'
    shift, capslock:                    'N'
    shift+capslock:                     'n'
}

key O {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
    shift+capslock:                     'o'
}

key P {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
    shift+capslock:                     'p'
}

key Q {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
    shift+capslock:                     'q'
}

key R {
    label:                              'R'
    base:                               'r'
    shift, capslock:                    'R'
    shift+capslock:                     'r'
}

key S {
    label:                              'S'
    base:                               's'
    shift, capslock:                    'S'
    shift+capslock:                     's'
}

key T {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'
    shift+capslock:                     't'
}

key U {
    label:                              'U'
    base:                               'u'
    shift, capslock:                    'U'
    shift+capslock:                     'u'
}

key V {
    label:                              'V'
    base:                               'v'
    shift, capslock:                    'V'
    shift+capslock:                     'v'
}

key W {
    label:                              'W'
    base:                               'w'
    shift, capslock:                    'W'
    shift+capslock:                     'w'
}

key X {
    label:                              'X'
    base:                               'x'
    shift, capslock:                    'X'
    shift+capslock:                     'x'
}

key Y {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
    shift+capslock:                     'y'
}

key Z {
    label:                              'Z'
    base:                               'z'
    shift, capslock:                    'Z'
    shift+capslock:                     'z'
}
