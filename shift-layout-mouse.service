[Unit]
Description=Stateful mouse gesture proxy for shift_layout
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/lib/shift_layout/mouse-meta-toggle /dev/input/by-id/usb-1ea7_2.4G_Mouse-if01-event-mouse 12
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
